# Leave both blank to run SPOTTED on its built-in localStorage demo layer.
# Fill both in (e.g. copy this file to .env.local) to activate the Supabase
# backend — see src/data/backend/README.md for setup steps.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Explicit browser payment mode. Keep "mock" until every activation gate in
# RAZORPAY_ROUTE.md is complete. Setting Supabase credentials alone must not
# enable real checkout.
VITE_PAYMENT_MODE=mock

# Razorpay runs entirely server-side in Supabase Edge Functions; its secrets
# are function config, never VITE_* browser vars. See RAZORPAY_ROUTE.md.
